{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Hardware Invariants & Silicon Telemetry",
      "tooltip": "Switch to Infrastructure & Hardware Invariants Dashboard",
      "type": "link",
      "url": "/d/hardware_invariants"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Service Health & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Prediction Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(taxon_predictions_total[1m]))",
          "legendFormat": "Requests / sec",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Error Ratio (5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(taxon_predictions_total{status=~\"error|unavailable\"}[5m])) or vector(0)) / clamp_min(sum(rate(taxon_predictions_total[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 120 }
            ]
          }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "p95 Inference Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(taxon_inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 Latency (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Statistical Drift & Manifold Exchangeability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "id": 6,
      "title": "Tier 1: Wasserstein-1 Distance vs Calibrated Threshold",
      "type": "timeseries",
      "targets": [
        {
          "expr": "taxon_drift_w1_distance",
          "legendFormat": "Observed W1",
          "refId": "A"
        },
        {
          "expr": "taxon_drift_w1_threshold",
          "legendFormat": "Threshold (tau_W1)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "scaleDistribution": { "type": "log", "log": 10 } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.01 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "id": 7,
      "title": "Tier 2: MMD² Permutation p-value",
      "type": "timeseries",
      "targets": [
        {
          "expr": "taxon_drift_mmd2_p_value",
          "legendFormat": "p-value (alpha=0.01)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "In-Distribution (Healthy)", "color": "green" }, "1": { "text": "Drift Detected", "color": "red" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 8,
      "title": "Active Drift Verdict",
      "type": "stat",
      "targets": [
        {
          "expr": "taxon_drift_detected",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 9,
      "title": "Live Application Logs & Triage Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 10,
      "title": "Real-Time Inference Logs",
      "type": "logs",
      "options": {
        "showLabels": false,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{job=\"taxon-vision\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["taxon-vision", "mlops", "monitoring"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "TaxonVision MLOps - Production Overview",
  "uid": "taxon_overview",
  "version": 1
}
