\providecolor{TaxonPrimary}{HTML}{1976D2}
\providecolor{TaxonSecondary}{HTML}{388E3C}
\providecolor{TaxonAccent}{HTML}{FBC02D}
\providecolor{TaxonDark}{HTML}{263238}

\begin{figure}[htbp]
    \centering
    \resizebox{\textwidth}{!}{
    \begin{tikzpicture}[
        node distance=1cm and 1.5cm,
        font=\sffamily\small,
        taxon_node/.style={draw=TaxonDark, fill=TaxonPrimary!10, thick, rounded corners, rectangle, align=center, minimum width=2.5cm, minimum height=0.7cm, drop shadow},
        rare_node/.style={draw=TaxonSecondary, fill=TaxonSecondary!10, thick, rounded corners, rectangle, align=center, minimum width=2.5cm, minimum height=0.7cm, drop shadow},
        math_box/.style={draw=TaxonDark, fill=gray!5, thick, rounded corners, rectangle, inner xsep=10pt, inner ysep=10pt, align=left, drop shadow},
        arrow/.style={-Stealth, thick, draw=TaxonDark},
        dashed_arrow/.style={-Stealth, thick, dashed, draw=TaxonDark!70}
    ]

        % ==========================================
        % LEFT: Taxonomic Tree Hierarchy
        % ==========================================
        \node[taxon_node] (kingdom) {Kingdom: \\ Animalia};
        \node[taxon_node, below=0.4cm of kingdom] (phylum) {Phylum: \\ Arthropoda};
        \node[taxon_node, below=0.4cm of phylum] (class) {Class: \\ Insecta};
        \node[taxon_node, below=0.4cm of class] (order) {Order: \\ Lepidoptera};
        \node[taxon_node, below=0.4cm of order] (family) {Family: \\ Nymphalidae};
        
        \node[taxon_node, below left=0.6cm and -0.5cm of family] (genus_danaus) {Genus: \\ \textit{Danaus}};
        \node[rare_node, below right=0.6cm and -0.5cm of family] (genus_rare) {Genus: \\ \textit{RareGenus}};
        
        \node[taxon_node, below=0.4cm of genus_danaus] (species_danaus) {Species: \\ \textit{Danaus plexippus} \\ $n_y \approx 5000$};
        \node[rare_node, below=0.4cm of genus_rare] (species_rare) {Species: \\ \textit{Rare species} \\ $n_y \approx 5$};

        \draw[arrow] (kingdom) -- (phylum);
        \draw[arrow] (phylum) -- (class);
        \draw[arrow] (class) -- (order);
        \draw[arrow] (order) -- (family);
        \draw[arrow] (family) -- (genus_danaus);
        \draw[arrow] (family) -- (genus_rare);
        \draw[arrow] (genus_danaus) -- (species_danaus);
        \draw[arrow] (genus_rare) -- (species_rare);

        \begin{scope}[on background layer]
            \node[draw=TaxonPrimary, fill=TaxonPrimary!3, dashed, thick, rounded corners, fit=(kingdom) (species_danaus) (species_rare), label={[font=\bfseries, text=TaxonPrimary]above:Biological Domain: DarwinCore Taxonomy}] (tree_box) {};
        \end{scope}

        % ==========================================
        % CENTER: Distribution Curve
        % ==========================================
        \begin{scope}[shift={(6, -3)}]
            % Axis
            \draw[thick, ->] (0,0) -- (4,0) node[right] {Classes ($y$)};
            \draw[thick, ->] (0,0) -- (0,4) node[above] {Frequency ($n_y$)};
            
            % Curve
            \draw[thick, TaxonPrimary, domain=0.2:3.8, samples=50] plot (\x, {3/\x});
            
            % Annotations
            \fill[TaxonPrimary!30] (0.2,0) -- (0.2,15) -- plot[domain=0.2:0.8] (\x, {3/\x}) -- (0.8,0) -- cycle; % Just visual shading approximation
            \draw[dashed] (0.8, 0) -- (0.8, 3.75);
            \node[above] at (0.5, 3.8) {\textbf{Head}};
            \node[above] at (2.5, 1.5) {\textbf{Long Tail}};
            
            \node[circle, fill=TaxonPrimary, inner sep=2pt, label={[font=\footnotesize]above:\textit{D. plexippus}}] (point_head) at (0.4, {3/0.4}) {};
            \node[circle, fill=TaxonSecondary, inner sep=2pt, label={[font=\footnotesize]above right:\textit{Rare species}}] (point_tail) at (3.5, {3/3.5}) {};

            \node[align=center, font=\bfseries\small, text=TaxonDark] at (2, -1) {Zipfian Imbalance \\ $n_y \gg 10^3$ vs $n_y \le 10$};
        \end{scope}
        
        % Connect tree to curve
        \draw[dashed_arrow] (species_danaus.east) to[out=0, in=180] (point_head);
        \draw[dashed_arrow] (species_rare.east) to[out=0, in=180] (point_tail);

        % ==========================================
        % RIGHT: Mathematical Formulation
        % ==========================================
        \node[math_box, right=6.5cm of tree_box.east, yshift=-1cm] (math) {
            \textbf{Class-Balanced Loss Formulation}\\[0.3cm]
            \textbf{Effective Number of Samples:}\\[0.1cm]
            $\displaystyle E_{n_y} = \frac{1 - \beta^{n_y}}{1 - \beta}, \quad \beta \in [0.99, 0.9999]$\\[0.2cm]
            \textbf{Weight Coefficient:}\\[0.1cm]
            $\displaystyle W_y = \frac{1}{E_{n_y}} = \frac{1 - \beta}{1 - \beta^{n_y}}$\\[0.2cm]
            \textbf{Loss Modulation:}\\[0.1cm]
            $\displaystyle \mathcal{L}_{\text{CB}}(z, y) = W_y \cdot \mathcal{L}_{\text{CE}}(z, y)$\\[0.2cm]
            \textbf{Asymptotic Behaviour:}\\
            $\bullet$ $n_y \to 1 \implies E_n \to 1$ (maximal weight) \\
            $\bullet$ $n_y \to \infty \implies E_n \to \frac{1}{1 - \beta}$ (saturation)
        };

        \begin{scope}[on background layer]
            \node[draw=TaxonAccent, fill=TaxonAccent!5, dashed, thick, rounded corners, fit=(math), label={[font=\bfseries, text=TaxonDark]above:Machine Learning Domain: Tensor Space}] (math_container) {};
        \end{scope}

        % Connect curve to math
        \draw[dashed_arrow] (5, 0) to[out=0, in=180] (math.west);
        \draw[dashed_arrow] (8, -2) to[out=0, in=180] (math.west);

    \end{tikzpicture}
    }
    \caption{Architectural bridging of the DarwinCore taxonomic hierarchy with the tensor-space Class-Balanced Loss regularisation. Left: The biological lineage highlighting severe class imbalance between common (e.g., \textit{Danaus plexippus}) and rare species. Centre: The resulting long-tail Pareto distribution. Right: The continuous mathematical formulation of effective sample volume preventing gradient dominance by abundant classes.}
    \label{fig:taxonomic_hierarchy_and_loss}
\end{figure}
