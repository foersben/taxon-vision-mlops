# TaxonVision-MLOps Local Container Overrides
# Default values suit rootless Podman on Linux (Arch/Fedora/Ubuntu).
# For standard rootful Docker Engine, uncomment the Docker defaults below.

# --- Rootless Podman Defaults (Arch Linux / UID 1000) ---
DOCKER_SOCK=/run/user/1000/podman/podman.sock
TRAEFIK_HTTP_PORT=8088
APP_PORT=8001
TAXON_RETRAIN_WEBHOOK_SECRET=dev-secret-token

# --- Standard Rootful Docker Engine Defaults ---
# DOCKER_SOCK=/var/run/docker.sock
# TRAEFIK_HTTP_PORT=80
# APP_PORT=8000
# TAXON_RETRAIN_WEBHOOK_SECRET=dev-secret-token
