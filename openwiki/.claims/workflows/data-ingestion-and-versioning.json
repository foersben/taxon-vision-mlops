  "claims": [
    {
      "id": "claim_187004f2f3f74a7bb362dbe6dd9fb50c",
      "statement": "The `INatAPIClient` rate-limits requests to 60 per minute by awaiting an `asyncio.sleep` delay before querying the iNaturalist v1 `/observations` endpoint, filters exclusively for research-grade observations with photos, and upgrades photo thumbnail URLs from square to medium resolution.",
      "evidence": [
        {
          "resource": "repo://src/taxon_vision/data/inat_client.py#L13-L99",
          "version": "repo-lines-v1:sha256:0ce4172e06e78ae86cea73a7c5787971ed141219f96380dbaf31e604adef1d17:"
        }
      ]
    },
    {
      "id": "claim_a8329fead319425bbcecc0791b1ebf6c",
      "statement": "The `LicenseFilter` validates citizen-science metadata against the `OpenLicense` enum to admit only CC0, CC-BY, and CC-BY-NC licenses, rejects direct hotlinks to `static.inaturalist.org` unless verified against an open dataset registry, and constructs immutable `AttributionRecord` instances retaining photographer attribution.",
      "evidence": [
        {
          "resource": "repo://src/taxon_vision/data/license_filter.py#L12-L101",
          "version": "repo-lines-v1:sha256:d3e56fd33d46f6622b1e15294b4591e2bad8e5ee9ae904cb98b3bb8622791a05:"
        },
        {
