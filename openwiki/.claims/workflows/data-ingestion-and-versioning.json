    {
      "id": "claim_66de1e26fcf84ecb88cf3078233f8140",
      "statement": "The `S3ImageStreamer` loads the Parquet manifest into memory and lazily yields RGB PIL Image objects directly from remote S3 URLs without local image disk persistence, supporting persistent single-connection sequential streaming and multithreaded concurrent streaming via a `ThreadPoolExecutor`.",
      "evidence": [
        {
          "resource": "repo://src/taxon_vision/data/s3_streamer.py#L92-L216",
          "version": "repo-lines-v1:sha256:2fc06dcc7a38907eaffa4cc90bc6731267d1bb238ec2010a2ee843c1ead1e887:"
        }
      ]
    },
    {
      "id": "claim_c7d82d7ed73b4f79b549cdef8c91e407",
      "statement": "The `_prepare_balanced_manifest` function samples observation records evenly across unique taxa based on a per-taxon quota, optionally shuffling partitions with a deterministic random seed before concatenation, to eliminate taxon representation imbalance during streaming.",
      "evidence": [
        {
          "resource": "repo://src/taxon_vision/data/s3_streamer.py#L21-L76",
