    {
      "id": "claim_187004f2f3f74a7bb362dbe6dd9fb50c",
      "statement": "The `INatAPIClient` rate-limits requests to 60 per minute using an asynchronous leaky-bucket rate limiter (`AsyncLimiter`) before querying the iNaturalist v1 `/observations` endpoint, filters exclusively for research-grade observations with photos, and upgrades photo thumbnail URLs from square to medium resolution.",
      "evidence": [
        {
          "resource": "repo://src/taxon_vision/data/inat_client.py#L13-L100",
          "version": "repo-lines-v1:sha256:b69864a1dba69df77e5224adf15fbce47ad2d19b7020b0a854a9569c645c0bc0:"
        }
      ]
    },
    {
      "id": "claim_a8329fead319425bbcecc0791b1ebf6c",
      "statement": "The `LicenseFilter` validates citizen-science metadata against the `OpenLicense` enum to admit only CC0, CC-BY, and CC-BY-NC licenses, rejects direct hotlinks to `static.inaturalist.org` unless verified against an open dataset registry, and constructs immutable `AttributionRecord` instances retaining photographer attribution.",
      "evidence": [
        {
          "resource": "repo://src/taxon_vision/data/license_filter.py#L12-L99",
          "version": "repo-lines-v1:sha256:5295ea5a75464db324ff1145b8d65a5e35c787b9ade00ba0e319b5e0fb047e30:"
        },
        {
