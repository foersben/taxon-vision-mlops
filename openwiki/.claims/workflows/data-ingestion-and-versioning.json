          "version": "repo-lines-v1:sha256:cb037fc65f016dd4662d4a12ef02738b7109fb91dc1225f1d1d78a4a1071fcd3:"
        }
      ]
    },
    {
      "id": "claim_22f83a8e1ab146c0942c3076c8f0a434",
      "statement": "The data ingestion and audit pipeline retrieves observation metadata across configured catalog taxa using `INatAPIClient` to produce `data/manifests/raw_manifest.parquet`, filters records through `LicenseFilter`, and writes compliant observation records to `data/manifests/dataset_manifest.parquet` using Polars.",
      "evidence": [
        {
          "resource": "repo://dvc.yaml#L2-L13",
          "version": "repo-lines-v1:sha256:c4c089d314b7d313c1c22778a1945a02af54b0120b22d46ab60485b448b0c754:"
