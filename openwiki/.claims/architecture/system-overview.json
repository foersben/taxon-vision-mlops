    {
      "id": "claim_70e3c54cb2c74bdbadbc6abd719f5a9f",
      "statement": "TaxonVision establishes a Single Source of Truth configuration hierarchy where base settings in config/default_config.yaml are layered sequentially with params.yaml, config/conformal_config.yaml, optional custom YAML overrides, direct environment flags (TAXON_ALLOW_UNTRAINED_FALLBACK and TAXON_FLAGGED_STORAGE_DIR), and dynamic double-underscore delimited TAXON_ environment variables.",
      "evidence": [
        {
          "resource": "repo://config/default_config.yaml#L1-L79",
          "version": "repo-lines-v1:sha256:3b789372010863b6d6d8fe3c8b1533cdf7875293a7060c7d809ba362697bd125:"
